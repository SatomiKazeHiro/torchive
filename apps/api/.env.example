PORT=2333

# API 前缀（与前端 Vite 代理保持一致；自定义时同步修改 apps/web/vite.config.ts）
API_PREFIX=ts-api

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600s

# SQLite
SQLITE_DB_PATH=./database/sqlite/
WORK_DIR_PATH=

# Super admin bootstrap
# Used only when the admin account does not exist yet. Do not commit a real password.
ADMIN_INITIAL_PASSWORD=
